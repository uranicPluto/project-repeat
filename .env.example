# Environment Configuration Template
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_repeat?schema=public"
APP_BASE_URL="http://localhost:3000"
SESSION_SECRET="dev-super-secure-session-secret-key-32-chars-minimum"
NODE_ENV="development"

# Payment Provider (Razorpay) - Optional / Mocked in Dev
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email Provider - Defaults to console in development
EMAIL_PROVIDER="console"
RESEND_API_KEY=""

# Object Storage Provider - Defaults to local
STORAGE_PROVIDER="local"

# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
